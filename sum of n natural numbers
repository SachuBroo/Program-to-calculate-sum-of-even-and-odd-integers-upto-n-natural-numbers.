#using while loop
n = int(input("Enter the total numbers upto which you want to find the sum: "))
sum = 1
sum_even = sum_odd = 0
while sum <= n:
    if sum%2 == 0:
        sum_even += sum
    else:
        sum_odd += sum
    sum += 1
print(f"Sum of even numbers: {sum_even}")
print(f"Sum of odd numbers: {sum_odd}")

#using for loop

N = int(input("Enter the total numbers upto which you want to find the sum: "))
even_sum = odd_sum = 0
for i in range(1,N+1):
    if i%2 == 0:
        even_sum += i
    else:
        odd_sum += i
print(f"Sum of even numbers: {even_sum}")
print(f"Sum of odd numbers: {odd_sum}")